# Server
PORT=4000
NODE_ENV=development
# Comma-separated browser origins. Native mobile clients need no CORS entry.
# Use * only for local development; set an explicit HTTPS origin in production.
CORS_ORIGIN=http://localhost:8081,http://localhost:19006
LOG_LEVEL=dev

# FRED API Key — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Protect manual push runs in production. Never expose either secret to Expo.
ADMIN_TOKEN=replace_with_a_long_random_secret

# Cache TTL (seconds)
# General market-data cache. The mobile stock quote endpoint has its own
# shorter window below so an old value is never presented as a current quote.
CACHE_TTL_PRICE=300
QUOTE_CACHE_TTL_SEC=60
QUOTE_STALE_GRACE_SEC=900
CACHE_TTL_MACRO=3600
CACHE_TTL_ONCHAIN=300
CACHE_TTL_STABLE=900
CACHE_TTL_RWA=1800
CACHE_TTL_ETF=1800
CACHE_STALE_GRACE=86400

# Upstream timeouts (ms)
UPSTREAM_TIMEOUT_MS=10000
RATE_LIMIT_PER_MIN=300
# Serialize cache-miss Yahoo calls from this server instance. Keep these
# server-only values on Render; the mobile app never needs them.
YAHOO_MIN_INTERVAL_MS=650
YAHOO_COOLDOWN_SEC=120
TRANSLATE_NEWS=true

# Push/alert runtime configuration
PUSH_ENABLED=true
ALERT_CRON=*/15 * * * *
SELF_BASE_URL=http://localhost:4000
PUSH_TOKEN_STORE=./data/push-tokens.json
ALERT_STATE_STORE=./data/alert-state.json

# Personal API and persistence (server-only; never expose these to Expo)
PERSONAL_API_TOKEN=replace_with_a_long_random_secret
# Required in production for per-install mobile sessions.
PERSONAL_SESSION_SECRET=replace_with_another_long_random_secret
PERSONAL_API_ALLOW_LOCAL=false
PERSONAL_STORE_PATH=./data/personal-store.json
PERSONAL_STORE_BACKEND=json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
